---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class={className}></span>

<style>
  span {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: var(--border-stroke-width) solid var(--color-foreground);
    background: var(--color-bg);
  }
</style>
