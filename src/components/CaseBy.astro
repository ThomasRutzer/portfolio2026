---
import type { CollectionEntry } from "astro:content";

type By = CollectionEntry<"cases">["data"]["by"];

interface Props {
  by: By;
}

const { by } = Astro.props;
const byLabel = typeof by === "string" ? by : by.label;
const byUrl = typeof by === "string" ? undefined : by.url;
---

<p class="case-by">
  {
    byUrl ? (
      <a href={byUrl} target="_blank" rel="noreferrer">
        {byLabel}
      </a>
    ) : (
      byLabel
    )
  }
</p>

<style>
  p {
    font-size: var(--font-step-0);
    letter-spacing: 0.1em;
    color: var(--color-ui);
    text-transform: uppercase;

    &::before {
      content: "└─";
      font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
      white-space: pre;
    }
  }

  a {
    color: inherit;
    text-decoration: none;

    &:hover,
    &:focus-visible {
      color: var(--color-p100);
    }
  }
</style>

<script>
  import { bindHoverFocusSFX, getSFX } from "@lib/sfx";

  const sfx = getSFX();
  const links = document.querySelectorAll<HTMLAnchorElement>(".case-by a");

  bindHoverFocusSFX(links);
  links.forEach((link) =>
    link.addEventListener("click", () => sfx.play("open")),
  );
</script>
