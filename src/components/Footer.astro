---
import ClipboardButton from "@components/ClipboardButton.astro";

interface LinkItem {
  label: string;
  href?: string;
  copy?: string;
}

interface FooterColumn {
  title: string;
  items: LinkItem[];
}

interface Props {
  columns?: FooterColumn[];
}
---

<footer class="container">
  <span class="flow" aria-hidden="true">∿ ⟶ /\ ⟶ ⊙</span>
  <nav aria-label="Contact and legal">
    <ClipboardButton label="hi@thomasrutzer.dev" copy="hi@thomasrutzer.dev" />
    <a href="/imprint">Imprint</a>
  </nav>
</footer>

<script>
  import { bindHoverFocusSFX } from "@lib/sfx";

  bindHoverFocusSFX(
    document.querySelectorAll<HTMLElement>("footer nav a, footer nav button"),
  );
</script>

<style>
  footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-l);
    margin-top: var(--space-l);
    padding-block: var(--space-l);
    color: var(--color-foreground);
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: space-between;
    gap: var(--space-l);
  }

  .flow {
    grid-column: 2;
    color: var(--color-p200);
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    justify-self: end;
    font-size: var(--font-step-0);
    color: var(--color-foreground);
  }
</style>
