---
interface LinkItem {
  label: string;
  href?: string;
  copy?: string;
}

interface FooterColumn {
  title: string;
  items: LinkItem[];
}

interface Props {
  columns?: FooterColumn[];
}

const {
  columns = [
    {
      title: "Connect",
      items: [{ label: "hi@thomasrutzer.dev", copy: "hi@thomasrutzer.dev" }],
    },
  ],
} = Astro.props as Props;

const year = new Date().getFullYear();
---

<footer class="container">
  <div class="bottom-bar">
    <span class="flow" aria-hidden="true">∿ ⟶ /\ ⟶ ⊙</span>
  </div>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    margin-top: var(--space-l);
    padding-block: var(--space-l);
    color: var(--color-foreground);
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: space-between;
    gap: var(--space-l);

    @media (max-width: 680px) {
      grid-template-columns: 1fr;
    }
  }

  .title {
    margin: 0 0 var(--space-s);
    color: var(--color-foreground);
    font-size: var(--font-step-0);
    text-transform: uppercase;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  a,
  .static,
  :global(.clipboard-field) {
    color: var(--color-ui);
    font-weight: 600;
  }

  a {
    text-decoration: none;

    &:hover,
    &:focus-visible {
      color: var(--color-p100);
    }
  }

  .bottom-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    border-top: 1px solid var(--color-muted);
    justify-content: center;
    padding-top: var(--space-m);

    .flow {
      color: var(--color-p200);
      letter-spacing: 0.4em;
    }

    p {
      margin: 0;
      color: var(--color-foreground);
      font-size: var(--font-step-0);
      text-align: right;
      line-height: 1.4;
    }

    svg {
      width: 2rem;
      height: 2rem;
      flex-shrink: 0;
      fill: var(--color-ui);
    }
  }
</style>
