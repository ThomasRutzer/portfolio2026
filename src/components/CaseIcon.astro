---
export type CaseIconVariant = "twin" | "orbit" | "eclipse";

interface Props {
  icon: CaseIconVariant;
}

const { icon } = Astro.props;
---

{
  icon === "twin" && (
    <svg
      width="12"
      height="12"
      viewBox="0 0 12 12"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <circle cx="1.2" cy="1.2" r="1.2" fill="currentColor" />
      <circle cx="1.2" cy="5.9998" r="1.2" fill="currentColor" />
      <circle cx="1.2" cy="10.7996" r="1.2" fill="currentColor" />
      <circle cx="5.9998" cy="1.2" r="1.2" fill="currentColor" />
      <circle cx="5.9998" cy="5.9998" r="1.2" fill="currentColor" />
      <circle cx="5.9998" cy="10.7996" r="1.2" fill="currentColor" />
      <circle cx="10.8001" cy="1.2" r="1.2" fill="currentColor" />
      <circle cx="10.8001" cy="5.9998" r="1.2" fill="currentColor" />
      <circle cx="10.8001" cy="10.7996" r="1.2" fill="currentColor" />
    </svg>
  )
}
{
  icon === "orbit" && (
    <svg
      width="13"
      height="13"
      viewBox="0 0 13 13"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d="M1.49316 0.0820312L0.493164 6.08203" stroke="currentColor" />
      <path d="M4.49316 0.0820312L3.49316 6.08203" stroke="currentColor" />
      <path d="M7.49316 0.0820312L6.49316 6.08203" stroke="currentColor" />
      <path d="M12.4932 0.0820312L11.4932 6.08203" stroke="currentColor" />
      <path
        d="M0.493165 6.08203L0.993164 9.08203L1.49316 12.082"
        stroke="currentColor"
      />
      <path
        d="M3.49316 6.08203L3.99316 9.08203L4.49316 12.082"
        stroke="currentColor"
      />
      <path
        d="M6.49316 6.08203L6.99316 9.08203L7.49316 12.082"
        stroke="currentColor"
      />
      <path
        d="M11.4932 6.08203L11.9932 9.08203L12.4932 12.082"
        stroke="currentColor"
      />
    </svg>
  )
}
{
  icon === "eclipse" && (
    <svg
      width="12"
      height="12"
      viewBox="0 0 12 12"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <circle cx="6" cy="6" r="5.5" stroke="currentColor" />
      <circle
        cx="7"
        cy="5"
        r="4"
        stroke="currentColor"
        stroke-linejoin="bevel"
        stroke-dasharray="0.5 0.5"
      />
      <circle cx="7.5" cy="4.5" r="3" stroke="currentColor" />
    </svg>
  )
}

<style>
  svg {
    width: 24px;
    height: 24px;
  }
</style>
