---
import Grid from "./Grid.astro";
import GridItem from "./GridItem.astro";
import SectionTitle from "./SectionTitle.astro";
import SoundToggle from "./SoundToggle.astro";
---

<header class="container">
  <Grid class="top-line" data-hero-top-line>
    <GridItem span={{ base: 2, sm: 2, md: 2 }} align="start">
      <SectionTitle withSpacing={false}>Intro</SectionTitle>
    </GridItem>
    <GridItem span={{ base: 2, sm: 2, md: 1 }} justify="center" align="start">
      <SoundToggle />
    </GridItem>
    <GridItem span={{ base: 2, sm: 2, md: 3 }} justify="end" align="start">
      <div class="status-line">
        <p class="location" data-hero-location>50.93825° N, 6.89799° E</p>
      </div>
    </GridItem>
  </Grid>
</header>
<section class="container-narrow">
  <h1 data-hero-title>
    Hej, I'm <span class="name">Thomas</span>. I architect & engineer <span
      class="highlight">unique interfaces & interactions</span
    > for the browser platform.
  </h1>
</section>

<noscript>
  <style>
    [data-hero-title] .name,
    [data-hero-title] .highlight {
      color: var(--color-ui) !important;
      -webkit-text-stroke: 0 !important;
    }
    [data-hero-title] .name {
      color: var(--color-p100) !important;
    }
    [data-hero-title] .highlight {
      color: var(--color-y100) !important;
    }
  </style>
</noscript>

<style>
  .top-line {
    color: var(--color-foreground);
    font-family: var(--font-main);
    font-size: var(--font-step-0);
    margin-bottom: var(--space-m);
    padding-bottom: var(--space-m);
    padding-top: var(--space-m);
  }

  .status-line {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .location {
    text-align: right;
    font-feature-settings: "tnum";
  }

  h1 {
    --stroke-width: 0.01em;
    --stroke-opacity: 10%;
    font-family: var(--font-title);
    font-size: var(--font-step-4);
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .name {
    color: transparent;
    -webkit-text-stroke: var(--stroke-width)
      color-mix(in srgb, var(--color-p300) var(--stroke-opacity), transparent);
    white-space: nowrap;
  }

  .highlight {
    color: transparent;
    -webkit-text-stroke: var(--stroke-width)
      color-mix(in srgb, var(--color-y100) var(--stroke-opacity), transparent);
  }

  h1 :global(.word) {
    display: inline-block;
    white-space: nowrap;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(SplitText);

  const topLine = document.querySelector<HTMLElement>("[data-hero-top-line]");
  const heading = document.querySelector<HTMLElement>("[data-hero-title]");
  const nameEl = heading?.querySelector<HTMLElement>(".name");
  const highlightEl = heading?.querySelector<HTMLElement>(".highlight");
  const locationEl = document.querySelector<HTMLElement>(
    "[data-hero-location]",
  );

  const mm = gsap.matchMedia();

  if (topLine) {
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.from(topLine, {
        opacity: 0,
        filter: "blur(4px)",
        duration: 1,
        ease: "sine.out",
      });
    });
  }

  if (nameEl && highlightEl) {
    const rootStyles = getComputedStyle(document.documentElement);
    const colors = {
      name: rootStyles.getPropertyValue("--color-p300").trim(),
      highlight: rootStyles.getPropertyValue("--color-y100").trim(),
    };

    const nameSplit = SplitText.create(nameEl, {
      type: "words, chars",
      aria: "auto",
    });
    const highlightSplit = SplitText.create(highlightEl, {
      type: "words, chars",
      aria: "auto",
    });

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.set([nameSplit.chars, highlightSplit.chars], { opacity: 0 });

      gsap
        .timeline({ defaults: { duration: 1.6, ease: "sine.inOut" } })
        .to(
          nameSplit.chars,
          { opacity: 1, stagger: { each: 0.05, ease: "sine.inOut" } },
          0,
        )
        .to(
          highlightSplit.chars,
          { opacity: 1, stagger: { each: 0.05, ease: "sine.inOut" } },
          0.4,
        )
        .to(
          nameSplit.chars,
          {
            color: colors.name,
            keyframes: {
              filter: ["blur(0px)", "blur(2px)", "blur(0px)"],
              easeEach: "sine.inOut",
            },
            stagger: { each: 0.05, ease: "sine.inOut" },
          },
          0.5,
        )
        .to(
          highlightSplit.chars,
          {
            color: colors.highlight,
            keyframes: {
              filter: ["blur(0px)", "blur(2px)", "blur(0px)"],
              easeEach: "sine.inOut",
            },
            stagger: { each: 0.05, ease: "sine.inOut" },
          },
          0.9,
        );
    });

    mm.add("(prefers-reduced-motion: reduce)", () => {
      gsap.set(nameSplit.chars, {
        opacity: 1,
        color: colors.name,
        filter: "blur(0px)",
      });
      gsap.set(highlightSplit.chars, {
        opacity: 1,
        color: colors.highlight,
        filter: "blur(0px)",
      });
    });
  }
</script>
