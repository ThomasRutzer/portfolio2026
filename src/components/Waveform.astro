---
import ClipboardButton from "@components/ClipboardButton.astro";

interface Label {
  /** 0–1, position along the waveform width */
  position: number;
  /** Plain-text label, used for the popover body and the dot's accessible name. If omitted, derived from `html` by stripping tags. */
  text?: string;
  href?: string;
  copy?: string;
  /** Raw HTML for the popover body, e.g. text with inline links. Overrides text/href. */
  html?: string;
}

interface Props {
  labels?: Label[];
  aspectRatio?: number;
}

const { labels = [], aspectRatio = 1 } = Astro.props;

// Fixed waveform data (sampled audio waveform). The SVG viewBox is 0 0 100 100.
const W = 100;
const H = 100;

const points: [number, number][] = [
  [0.0, 50.0],
  [1.27, 50.82],
  [2.53, 51.25],
  [3.8, 50.56],
  [5.06, 50.45],
  [6.33, 48.59],
  [7.59, 44.51],
  [8.86, 45.57],
  [10.13, 52.77],
  [11.39, 56.04],
  [12.66, 53.87],
  [13.92, 53.91],
  [15.19, 52.21],
  [16.46, 42.29],
  [17.72, 36.73],
  [18.99, 46.23],
  [20.25, 56.58],
  [21.52, 56.67],
  [22.78, 57.5],
  [24.05, 60.14],
  [25.32, 49.33],
  [26.58, 32.92],
  [27.85, 35.22],
  [29.11, 50.05],
  [30.38, 55.26],
  [31.65, 57.04],
  [32.91, 65.73],
  [34.18, 62.55],
  [35.44, 40.36],
  [36.71, 28.74],
  [37.97, 39.89],
  [39.24, 49.36],
  [40.51, 51.34],
  [41.77, 63.19],
  [43.04, 72.77],
  [44.3, 56.27],
  [45.57, 33.19],
  [46.84, 33.2],
  [48.1, 42.57],
  [49.37, 43.58],
  [50.63, 52.74],
  [51.9, 72.09],
  [53.16, 70.7],
  [54.43, 46.87],
  [55.7, 34.9],
  [56.96, 39.49],
  [58.23, 38.89],
  [59.49, 40.76],
  [60.76, 60.42],
  [62.03, 74.34],
  [63.29, 61.09],
  [64.56, 43.74],
  [65.82, 41.97],
  [67.09, 40.19],
  [68.35, 34.82],
  [69.62, 45.74],
  [70.89, 65.9],
  [72.15, 67.07],
  [73.42, 53.37],
  [74.68, 47.65],
  [75.95, 45.85],
  [77.22, 37.7],
  [78.48, 37.65],
  [79.75, 52.89],
  [81.01, 62.81],
  [82.28, 57.57],
  [83.54, 52.1],
  [84.81, 51.13],
  [86.08, 45.32],
  [87.34, 39.73],
  [88.61, 45.27],
  [89.87, 54.23],
  [91.14, 55.13],
  [92.41, 52.52],
  [93.67, 52.23],
  [94.94, 50.44],
  [96.2, 47.0],
  [97.47, 47.19],
  [98.73, 49.79],
  [100.0, 50.48],
];

// Flatten the amplitude around the centerline so the wave reads as calmer.
const AMPLITUDE = 0.45;
const scaledPoints: [number, number][] = points.map(([x, y]) => [
  x,
  50 + (y - 50) * AMPLITUDE,
]);

const d = scaledPoints
  .map(([x, y], i) => `${i === 0 ? "M" : "L"} ${x.toFixed(2)},${y.toFixed(2)}`)
  .join(" ");

// Map label positions to actual SVG x coords and interpolate y.
function yAtX(x: number): number {
  let i = 0;
  while (i < scaledPoints.length - 2 && scaledPoints[i + 1][0] < x) i++;
  const [x0, y0] = scaledPoints[i];
  const [x1, y1] = scaledPoints[i + 1];
  const t = x1 === x0 ? 0 : (x - x0) / (x1 - x0);
  return y0 + (y1 - y0) * t;
}

const labelPoints = labels.map((l, i) => {
  const x = l.position * W;
  const y = yAtX(x);
  const id = `wf-label-${i}`;
  const text = l.text ?? l.html?.replace(/<[^>]+>/g, "").trim() ?? "";
  return { ...l, x, y, id, text };
});
---

<div class="waveform">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="wf-fade" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0"></stop>
        <stop offset="12%" stop-color="currentColor" stop-opacity="1"></stop>
        <stop offset="88%" stop-color="currentColor" stop-opacity="1"></stop>
        <stop offset="100%" stop-color="currentColor" stop-opacity="0"></stop>
      </linearGradient>
      <mask id="wf-mask">
        <rect width={W} height={H} fill="url(#wf-fade)"></rect>
      </mask>
    </defs>

    <path
      d={d}
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"
      mask="url(#wf-mask)"></path>
  </svg>

  {
    labelPoints.map(({ x, y, id, text, href, copy, html }) => (
      <>
        <button
          class="label-dot"
          style={`--dx: ${(x / W) * 100}%; --dy: ${(y / H) * 100}%; --anchor: --${id}`}
          popovertarget={id}
          aria-haspopup="true"
          aria-label={text}
          tabindex="0"
        />
        <div
          id={id}
          popover="hint"
          class="label-popover"
          style={`--anchor: --${id}`}
        >
          {html ? (
            <span set:html={html} />
          ) : copy ? (
            <ClipboardButton label={text} copy={copy} />
          ) : href ? (
            <a href={href} autofocus>
              {text}
            </a>
          ) : (
            text
          )}
        </div>
      </>
    ))
  }
</div>

<style define:vars={{ "wf-aspect": aspectRatio }}>
  .waveform {
    position: relative;
    width: 100%;
    color: var(--color-p100);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--wf-aspect);
    overflow: visible;
  }

  .label-dot {
    appearance: none;
    anchor-name: var(--anchor);
    position: absolute;
    left: var(--dx);
    top: var(--dy);
    translate: -50% -50%;
    width: 7px;
    height: 7px;
    padding: 0;
    margin: 0;
    border: none;
    border-radius: 50%;
    background: var(--color-p100);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-p100) 25%, transparent);
    cursor: pointer;
    transition:
      scale 150ms ease,
      box-shadow 150ms ease;

    &:hover,
    &:focus-visible {
      scale: 1.5;
      outline: none;
      box-shadow: 0 0 0 4px
        color-mix(in srgb, var(--color-p100) 35%, transparent);
    }

    &:focus:not(:focus-visible) {
      outline: none;
    }
  }

  .label-popover {
    /* Remove default centered positioning so anchor rules take over */
    margin: unset;
    inset: unset;
    /* CSS Anchor Positioning — Chrome 125+ */
    position-anchor: var(--anchor);
    bottom: calc(anchor(top) + 8px);
    left: anchor(center);
    translate: -50% 0;
    padding: 0.25rem 0.625rem;
    background: var(--color-panel);
    color: var(--color-ui);
    font-family: var(--font-main);
    font-size: var(--font-step-0);
    border: var(--border-stroke-width) solid var(--color-muted);
    border-radius: var(--border-radius-s);
    max-width: 24ch;

    opacity: 0;
    scale: 0.85;
    transition:
      opacity 160ms ease,
      scale 160ms ease,
      display 160ms allow-discrete,
      overlay 160ms allow-discrete;

    &:popover-open {
      opacity: 1;
      scale: 1;

      @starting-style {
        opacity: 0;
        scale: 0.85;
      }
    }

    a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 2px;

      &:hover,
      &:focus-visible {
        color: var(--color-p100);
      }
    }

    :global(.clipboard-field) {
      color: inherit;

      &:hover,
      &:focus-visible {
        color: var(--color-p100);
      }
    }
  }
</style>

<script>
  import { bindHoverFocusSFX, getSFX } from "@lib/sfx";

  const sfx = getSFX();

  bindHoverFocusSFX(
    document.querySelectorAll<HTMLButtonElement>(".waveform .label-dot"),
  );

  // "hint" popovers auto-close the previous one when a new one opens, firing
  // its close toggle before the new open toggle (same task). Defer the close
  // sound so a swap between dots only plays "open", not "close" then "open".
  let openPopoverCount = 0;

  document
    .querySelectorAll<HTMLElement>(".waveform .label-popover")
    .forEach((popover) => {
      popover.addEventListener("toggle", (e) => {
        if ((e as ToggleEvent).newState === "open") {
          openPopoverCount++;
          sfx.play("open");
        } else {
          openPopoverCount--;
          queueMicrotask(() => {
            if (openPopoverCount === 0) sfx.play("close");
          });
        }
      });
    });
</script>
