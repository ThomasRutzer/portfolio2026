---
import type { CollectionEntry } from "astro:content";

type By = CollectionEntry<"cases">["data"]["by"];

interface Props {
  startDate: Date;
  endDate?: Date;
  by: By;
}

const { startDate, endDate, by } = Astro.props;
const byLabel = typeof by === "string" ? by : by.label;
const byUrl = typeof by === "string" ? undefined : by.url;
---

<div class="case-year-by">
  <span>
    {endDate && <span> {endDate.getFullYear()} —</span>}
    {startDate.getFullYear()}
  </span>

  {
    byUrl ? (
      <a class="case-by" href={byUrl} target="_blank" rel="noreferrer">
        {byLabel}
      </a>
    ) : (
      <span class="case-by">{byLabel}</span>
    )
  }
</div>

<style>
  div {
    display: flex;
    font-size: var(--font-step-0);
    letter-spacing: 0.1em;
    color: var(--color-ui);
    text-number: tabular-nums;
    flex-direction: column;
    align-items: flex-end;
    text-transform: uppercase;
  }

  a.case-by {
    color: inherit;
    text-decoration: none;

    &:hover,
    &:focus-visible {
      color: var(--color-p100);
    }
  }
</style>

<script>
  import { bindHoverFocusSFX, getSFX } from "@lib/sfx";

  const sfx = getSFX();
  const links = document.querySelectorAll<HTMLAnchorElement>(
    ".case-year-by a.case-by",
  );

  bindHoverFocusSFX(links);
  links.forEach((link) =>
    link.addEventListener("click", () => sfx.play("open")),
  );
</script>
