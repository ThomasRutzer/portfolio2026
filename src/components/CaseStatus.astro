---
import type { CollectionEntry } from "astro:content";

type Status = CollectionEntry<"cases">["data"]["status"];

interface Props {
  status: Status;
}

const { status } = Astro.props;

const STAGES: { value: Status; label: string }[] = [
  { value: "planned", label: "Planned" },
  { value: "progress", label: "Progress" },
  { value: "deployed", label: "Deployed" },
  { value: "archived", label: "Archived" },
];
---

<ul class="status-set" role="list" aria-label="Case status">
  {
    STAGES.map((stage) => (
      <li
        class="stage"
        aria-current={stage.value === status ? "true" : undefined}
      >
        <span class="label">{stage.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .status-set {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--space-s);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stage {
    display: flex;
    align-items: center;
  }

  .label {
    font-family: var(--font-main);
    font-size: var(--font-step-0);
    text-transform: uppercase;
    color: var(--color-body);
  }

  .stage[aria-current="true"] .label {
    color: var(--color-p100);
    font-weight: 600;
  }
</style>
