---
import type { HTMLTag } from "astro/types";
import Signal from "./Signal.astro";

interface Props {
  tag?: HTMLTag;
  class?: string;
  id?: string;
  variant?: "light" | "dark";
  signalVariant?: "purple" | "yellow";
  [key: string]: any;
  withSpacing?: boolean;
}

const {
  tag: Tag = "h2",
  class: className = "",
  id,
  variant = "dark",
  signalVariant,
  withSpacing = true,
  ...rest
} = Astro.props as Props;
---

<Tag
  {id}
  class:list={[
    "section-title",
    {
      spaced: withSpacing,
      dark: variant === "dark",
    },
    className,
  ]}
  {...rest}
>
  <Signal variant={signalVariant} />
  <slot />
</Tag>

<style>
  .section-title {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    font-family: var(--font-main);
    font-size: var(--font-step-0);
    color: var(--color-ui);
    font-weight: normal;
    text-transform: uppercase;

    &.spaced {
      margin-block: var(--space-m);
    }

    &.dark {
      color: var(--color-foreground);
    }
  }
</style>
