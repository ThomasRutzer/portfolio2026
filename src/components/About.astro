---
import Panel from "@components/Panel.astro";
import Progress from "@components/Progress.astro";
import Waveform from "@components/Waveform.astro";
import Image from "astro/components/Image.astro";
import image from "./../assets/images/thomasrutzer.png";
import SectionConnector from "./SectionConnector.astro";
import SectionTitle from "./SectionTitle.astro";
---

<section class="about container">
  <SectionConnector width="sm" direction="reverse" withSpacing={false} />
  <Panel>
    <SectionTitle
      tag="p"
      signalVariant="yellow"
      variant="light"
      withSpacing={false}>About Me</SectionTitle
    >
    <div class="rig">
      <figure>
        <div class="portrait">
          <Image src={image} alt="" aria-hidden="true" class="sleeve" />
          <Image src={image} alt="Operator" class="vinyl" />
        </div>
      </figure>

      <div class="wave">
        <Waveform
          variant="yellow"
          aspectRatio={100 / 20}
          labels={[
            {
              position: 0.25,
              text: "Intro",
              href: "https://thomasrutzer.dev",
            },
            { position: 0.4, text: "Drop", href: "https://thomasrutzer.dev" },
            {
              position: 0.85,
              text: "hi@thomasrutzer.dev",
              copy: "hi@thomasrutzer.dev",
            },
          ]}
        />
      </div>

      <Progress label="Experience" value="12 years" progress={28} />
    </div>
  </Panel>
</section>

<style>
  .about {
    margin-top: var(--space-l);
    color: var(--color-ui);
  }

  .rig {
    display: grid;
    grid-template-columns: auto auto auto;
    align-items: center;
    gap: var(--space-l);

    @media (max-width: 900px) {
      grid-template-columns: 1fr;
    }
  }

  figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin: var(--space-m);

    .portrait {
      position: relative;
      width: 100%;
      height: 100%;
      aspect-ratio: 1 / 1;
      filter: brightness(0.55) saturate(1.2);

      &::after {
        content: "";
        position: absolute;
        inset: 0;
        margin: auto;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: var(--color-ui);
      }
    }

    .sleeve {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .vinyl {
      position: absolute;
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
      outline: 1px solid var(--color-ui);
      outline-offset: -16px;
      object-fit: cover;
      animation: spin 20s linear infinite;

      @media (prefers-reduced-motion: reduce) {
        animation: none;
      }
    }
  }

  .wave {
    min-width: 0;
  }

  .connector-attached {
    margin-bottom: -7px;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
