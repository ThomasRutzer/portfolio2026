---
import Panel from "@components/Panel.astro";
import Progress from "@components/Progress.astro";
import Waveform from "@components/Waveform.astro";
import Image from "astro/components/Image.astro";
import image from "./../assets/images/thomasrutzer.png";
import SectionConnector from "./SectionConnector.astro";
import SectionTitle from "./SectionTitle.astro";

const birth = new Date("1988-12-24");
const now = new Date();
const hadBirthday =
  now.getMonth() > birth.getMonth() ||
  (now.getMonth() === birth.getMonth() && now.getDate() >= birth.getDate());
const lifeYears =
  now.getFullYear() - birth.getFullYear() - (hadBirthday ? 0 : 1);
---

<section class="about container">
  <SectionConnector width="sm" direction="reverse" withSpacing={false} />
  <Panel>
    <SectionTitle
      tag="p"
      signalVariant="yellow"
      variant="light"
      withSpacing={false}>Me</SectionTitle
    >
    <div class="rig">
      <figure>
        <div class="portrait">
          <Image src={image} alt="" aria-hidden="true" class="sleeve" />
          <Image src={image} alt="Operator" class="vinyl" />
        </div>
      </figure>

      <div class="wave">
        <Waveform
          aspectRatio={100 / 20}
          labels={[
            {
              position: 0.6,
              html: 'A good read is <a href="https://www.thalia.de/shop/home/artikeldetails/A1068926167" target="_blank">Yellowface</a> from R. F. Kuang',
            },

            {
              position: 0.2,
              html: 'A good song is <a href="https://www.youtube.com/watch?v=XPVNKIqy_cw" target="_blank">Drag my body</a> from Hot Water Music',
            },
            {
              position: 0.85,
              text: "hi@thomasrutzer.dev",
              html: 'A good recipe is <a href="https://www.eat-this.org/loaded-hummus-mit-geroestetem-blumenkohl/" target="_blank">Loaded Hummus mit geröstetem Blumenkohl</a> from Eat This!',
            },
          ]}
        />
      </div>

      <Progress
        label="Life Experience"
        value={`${lifeYears} years`}
        progress={28}
      />
    </div>
  </Panel>
</section>

<style>
  .about {
    margin-top: var(--space-l);
    color: var(--color-ui);
    container-type: inline-size;
    container-name: about;
  }

  .rig {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--space-l);

    @container about (min-width: 900px) {
      grid-template-columns: auto auto auto;
    }
  }

  figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin: 0 var(--space-m);

    @container about (min-width: 900px) {
      margin: 0;
    }

    .portrait {
      position: relative;
      width: 100%;
      height: 100%;
      aspect-ratio: 1 / 1;
      filter: brightness(0.55) saturate(1.2);

      &::after {
        content: "";
        position: absolute;
        inset: 0;
        margin: auto;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: var(--color-ui);
      }
    }

    .sleeve {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .vinyl {
      position: absolute;
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
      outline: 1px solid var(--color-ui);
      outline-offset: -16px;
      object-fit: cover;
      animation: spin 20s linear infinite;

      @media (prefers-reduced-motion: reduce) {
        animation: none;
      }
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
