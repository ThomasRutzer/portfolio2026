---
import Jack from "@components/Jack.astro";

interface Props {
  width?: "sm" | "md" | "lg" | "full";
  direction?: "normal" | "reverse";
  withSpacing?: boolean;
}

const { width = "md", direction = "normal", withSpacing = true } = Astro.props;
---

<div
  class:list={[
    "connector",
    `width-${width}`,
    { reverse: direction === "reverse", spaced: withSpacing },
  ]}
  aria-hidden="true"
>
  <Jack class="dot output" />
  <svg class="cable" viewBox="0 0 100 100" preserveAspectRatio="none">
    <path d="M 100 0 C 100 80, 0 20, 0 100" vector-effect="non-scaling-stroke"
    ></path>
  </svg>
  <Jack class="dot input" />
</div>

<style>
  .connector {
    position: relative;
    height: var(--space-2xl-3xl);
    margin-inline: auto;

    &.reverse {
      transform: scaleX(-1);
    }

    &.spaced {
      margin-block: var(--space-m);
    }

    &.width-sm {
      width: 25%;
    }

    &.width-md {
      width: 50%;
    }

    &.width-lg {
      width: 70%;
    }

    &.width-full {
      width: 100%;
    }
  }

  .cable {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;

    path {
      fill: none;
      stroke: var(--color-foreground);
      stroke-width: 4;
    }
  }

  :global(.dot) {
    position: absolute;
    left: 0;
    transform: translate(-50%, -50%);
    z-index: 1;
  }

  :global(.dot.output) {
    top: 0;
    left: 100%;
  }

  :global(.dot.input) {
    top: 100%;
  }
</style>
