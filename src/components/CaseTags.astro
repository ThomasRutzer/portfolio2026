---
interface Tag {
  label: string;
  type: "engineering" | "architecture";
}

interface Props {
  tags?: Tag[];
}

const { tags = [] } = Astro.props;
---

{
  tags.length > 0 && (
    <div class="case-tags" aria-label="Disciplines and technologies">
      {tags.map((tag) => (
        <span class={`case-tags__pill case-tags__pill--${tag.type}`}>
          {tag.label}
        </span>
      ))}
    </div>
  )
}

<style>
  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
</style>
