---
interface Tag {
  label: string;
  type: "engineering" | "architecture";
}

interface Props {
  tags?: Tag[];
}

const { tags = [] } = Astro.props;
---

{
  tags.length > 0 && (
    <div class="case-tags" aria-label="Disciplines and technologies">
      {tags.map((tag) => (
        <span class={`case-tags__pill case-tags__pill--${tag.type}`}>
          {tag.label}
        </span>
      ))}
    </div>
  )
}

<style>
  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .case-tags__pill {
    font-family: var(--font-main);
    font-size: var(--font-step-0);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: 4px;
    border: 1px solid;
    line-height: 1;
  }

  .case-tags__pill--engineering {
    color: var(--color-y100);
    border-color: var(--color-y100);
    background: transparent;
  }

  .case-tags__pill--architecture {
    color: var(--color-body);
    border-color: var(--color-muted);
    background: var(--color-inactive);
  }
</style>
