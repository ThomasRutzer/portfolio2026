---
interface Props {
  tech: string[];
}

const { tech } = Astro.props;
---

<ul class="repo-data" aria-label="Tech stack">
  {
    tech.map((t, i) => (
      <li class="row">
        <span>{t}</span>
        {i === tech.length - 1 && <span class="cursor" aria-hidden="true" />}
      </li>
    ))
  }
</ul>

<style>
  .repo-data {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-inline-start: var(--space-l);
    background: var(--color-panel);
    margin: 0;
  }

  .row {
    list-style: ">  ";
    max-inline-size: 60ch;
    font-size: var(--font-step-0);

    &::marker {
      color: var(--color-p100);
    }

    span:first-child {
      text-transform: uppercase;
      color: var(--color-ui);
    }
  }

  .cursor {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-inline-start: 0.15em;
    background: var(--color-y100);
    vertical-align: -0.15em;
    animation: blink 1s step-end infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>
