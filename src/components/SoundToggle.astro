---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button type="button" class={className} data-sound-toggle aria-pressed="true">
  <svg class="wave" viewBox="0 0 40 16" aria-hidden="true">
    <path
      class="wave-path"
      d="M0 8 L4 8 L6 3 L9 13 L12 5 L15 11 L18 6 L21 10 L24 4 L27 12 L30 7 L33 9 L36 8 L40 8"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="label" data-sound-toggle-label>Sound on</span>
</button>

<style>
  button {
    display: flex;
    align-items: center;
    flex-direction: column-reverse;
    border: none;
    background: none;
    padding: var(--space-xs);
    margin: 0;
    margin-top: calc(var(--space-xs) * -1);
    color: var(--color-foreground);
    cursor: pointer;
    transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
    gap: var(--space-xs);

    &:hover,
    &:focus-visible {
      color: var(--color-y100);
    }

    &:active {
      transform: scale(0.97);
    }
  }

  .wave {
    display: block;
    width: 2.5rem;
    height: auto;
    color: var(--color-y100);
    transition: opacity 200ms ease;
  }

  .wave-path {
    d: path(
      "M0 8 L4 8 L6 3 L9 13 L12 5 L15 11 L18 6 L21 10 L24 4 L27 12 L30 7 L33 9 L36 8 L40 8"
    );
    transition: d 350ms cubic-bezier(0.77, 0, 0.175, 1);
  }

  .label {
    font-family: var(--font-main);
    font-size: var(--font-step-0);
    text-transform: uppercase;
    white-space: nowrap;
  }

  button[aria-pressed="false"] {
    .wave-path {
      d: path(
        "M0 8 L4 8 L6 8 L9 8 L12 8 L15 8 L18 8 L21 8 L24 8 L27 8 L30 8 L33 8 L36 8 L40 8"
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave-path {
      transition: none;
    }
  }

  @container grid (min-width: 600px) {
    button {
      flex-direction: row;
    }
  }
</style>

<script>
  import { getSFX, bindHoverFocusSFX } from "@lib/sfx";

  const sfx = getSFX();

  const buttons = document.querySelectorAll<HTMLButtonElement>(
    "[data-sound-toggle]",
  );

  bindHoverFocusSFX(buttons);

  buttons.forEach((button) => {
    const label = button.querySelector<HTMLElement>(
      "[data-sound-toggle-label]",
    );

    function render(enabled: boolean) {
      button.setAttribute("aria-pressed", String(enabled));
      if (label) label.textContent = enabled ? "Sound on" : "Sound off";
    }

    render(sfx.isEnabled());

    button.addEventListener("click", () => {
      const enabled = !sfx.isEnabled();

      if (!enabled) sfx.play("toggle-off");
      sfx.setEnabled(enabled);
      if (enabled) sfx.play("toggle-on");

      render(enabled);
    });
  });
</script>
