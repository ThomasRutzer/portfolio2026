---
interface Props {
  label: string;
  value?: string;
  progress: number; // 0–100
  ariaLabel?: string;
}

const { label, value, progress, ariaLabel = label } = Astro.props;
const clamped = Math.max(0, Math.min(100, progress));

const BAR_COUNT = 40;
const activeCount = Math.round((clamped / 100) * BAR_COUNT);
const bars = Array.from({ length: BAR_COUNT }, (_, i) => ({ active: i < activeCount }));
---

<figure>
  <figcaption>
    <span class="label">{label}</span>
    {value && <span class="value">{value}</span>}
  </figcaption>
  <div
    class="bars"
    role="progressbar"
    aria-valuenow={clamped}
    aria-valuemin={0}
    aria-valuemax={100}
    aria-label={ariaLabel}
  >
    {
      bars.map((bar, i) => (
        <span class:list={["bar", { active: bar.active }]} style={`--i: ${i}`} />
      ))
    }
  </div>
</figure>

<style>
  figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin: 0;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .label {
    font-family: var(--font-main);
    font-size: var(--font-step-0);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ui);
  }

  .value {
    font-family: var(--font-main);
    font-size: var(--font-step-0);
    color: var(--color-ui);
  }

  .bars {
    display: flex;
    gap: 2px;
    height: var(--space-s);
  }

  .bar {
    flex: 1;
    min-width: 2px;
    border-radius: 1px;
    background: var(--color-ui);

    &.active {
      animation: bar-fill 0.4s calc(var(--i) * 25ms) ease both,
        bar-glow 3s calc(var(--i) * 90ms) ease-in-out infinite;
    }
  }

  @keyframes bar-fill {
    from {
      background: var(--color-ui);
    }
    to {
      background: var(--color-p100);
    }
  }

  @keyframes bar-glow {
    0%,
    100% {
      filter: brightness(1);
    }
    50% {
      filter: brightness(1.35);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar.active {
      animation: none;
      background: var(--color-p100);
    }
  }
</style>
